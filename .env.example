# Copy this file to .env.local for local development.
# UI-Finder runs fully with NONE of these set, using a small checked-in
# fixture dataset (data/sections.seed.json) as its search index — see README.

# Optional: Supabase/Postgres connection string (with pgvector enabled).
# When unset, the app falls back to the local JSON section store
# (data/sections.seed.json + data/sections.local.json) automatically.
# Example: postgres://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_URL=

# Optional: cap how many candidate sections the /api/search pre-filter
# pulls from the store before detailed scoring. Defaults to 200.
SEARCH_PREFILTER_LIMIT=

# Optional: the crawler uses your already-installed Google Chrome or
# Microsoft Edge automatically (no separate browser download needed).
# Only set this if it can't find either on its own — point it at your
# browser's executable directly.
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# Mac example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_EXECUTABLE_PATH=
